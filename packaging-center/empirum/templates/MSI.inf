[SetupInfo]
Author                  = 
CreationDate            = 
InventoryID             = 
Description             = 
Method                  = MSI
Tested on               = Win11 (22H2)
Dependencies            = 
Command line options    = /S0
Last Change             = 
Build                   = 1.00
Templateversion			= 12.10.2023
Auftragsnummer			= 
Besteller				= 
Abhängige Programme		= 

Buildnr.	Datum		Name			Beschreibung
1.00		12.10.2023				Initialpaket

[VarDefInfo]

[Setup]
Version=14.2
ShowCaption=1
BlockInput=0
Platform=

[Requirements]

[Application]
ProductName={ProductName}
DeveloperName={DeveloperName}
Version={Version}
Revision=0
SetupName=%ProductName% %Version% %SetupWizard%
Text1="%ProductName% %Version%",         Arial,           30, , 2170F3, 4,    , LEFT BOLD ITALIC
Text2="%DeveloperName%",                 Arial,           24, , 2170F3, 4,    , LEFT BOLD ITALIC
Text8="%Company%",                       Arial,           18, , 2170F3, 4,  10, RIGHT BOLD ITALIC
Text9="%InstallationFor% %WindowsUser%", Arial,           16, , 2170F3, 4, -18, BOTTOM ITALIC LEFT
BackgroundColor=EFEFEF,000000
; BackgroundPicture=Logo.bmp, -10#, -10#, 0, 0, 000000, NORMAL
CopyDialogRect=0%, 77%, 100%, 100%, HCENTER

; Register all installations in common registry key
UserKeyName=$Matrix42Packages$\%DeveloperName%\%ProductName%
MachineKeyName=$Matrix42Packages$\%DeveloperName%\%ProductName%\%Version%
UninstallKeyName=Matrix42 - %DeveloperName% %ProductName% %Version%
UninstallDisplayName=Matrix42 - %DeveloperName% %ProductName% %Version%
UninstallString=%ReinstallString% /U
ReinstallString="%CommonSetupDir%\Setup.exe" "%App%\%SetupInfDir%\Setup.inf"
UninstallDisplayIcon="%ApplicationDir%\%SetupInfDir%\Setup.ico",0
UninstallOptions=NOREMOVE NOREPAIR NOMODIFY
ReinstallMode=1
SrcDir=..

; Matrix42 Scripts are copied in a common scripts directory
ApplicationDir=%CommonAppData%\$Matrix42Scripts$\%DeveloperName%\%ProductName%\%Version%

SetupInfDir=Install
DataDir=%Personal%
AskUninstallOld=0
ShellLinks=1
CommonShellLinks=1
CreateUnresolvableShellLinks=1
UseStringSection=Strings:09
UseSysStringSection=SysStrings:09
DateWarning=1
SizeWarning=0
Reboot=0
PreventExternalReboot=1
StartServicesOnReboot=0
CallTimeOut=3600
AbortAfterCallTimeOut=1
DisableCancelButton=1
ShowEndMessage=1
EndMessage=%EndMessageDesc%

[Strings:07]
Disk1=Installationsmedium 1
EndMessageDesc=Die Installation wurde erfolgreich abgeschlossen!
ErrorLogMessage=Die Installation/Deinstallation wurde mit einer Fehlermeldung abgebrochen!
InstallationFor=Installation für:
InstallerDesc=Dienstprogramm zum Installieren einzelner Komponenten.
InstallerName=Installationsprogramm
SetupWizard=Installations-Assistent
Uninstallation=deinstallieren

[Strings:09]
Disk1=Installation media 1
EndMessageDesc=Installation was completed successfully!
ErrorLogMessage=The installation/uninstallation aborted with an error message!
InstallationFor=Installation for:
InstallerDesc=Service program to install single components.
InstallerName=Setup program
SetupWizard=Installation Wizard
Uninstallation=Uninstallation

[SysStrings:07]
; German - use this section to define variables that are different in German / English 
Users=Benutzer

[SysStrings:09]
; English - use this section to define variables that are different in German / English
Users=Users

[Environment]
; Directory-Definitions
V_SourceDir=Files

; Import computer variable
; V_ClientUmgebung=%%%V_MachineValuesPath%\%ComputerName%.ini,%ComputerName%,Intern-ClientUmgebung%%

ReInstSuccessMessage1031=Die Konfiguration wurde erfolgreich abgeschlossen.
ReInstSuccessMessage1031_1=Die Konfiguration wurde abgeschlossen.
ReInstSuccessMessage1033=Configuration completed successfully.
ReInstSuccessMessage1033_1=Configuration completed.
MSILogFile=%App%\%DeveloperName%.%ProductName%.%Version%.%Revision%.MSI.log
MSIPatchLogFile=%App%\%DeveloperName%.%ProductName%.%Version%.%Revision%.MSI.Patch.log
CommonSetupDir=%CommonFilesDir%\Setup%SetupBits%
V_MachineValuesPath=\\%EmpirumServer%\Values$\MachineValues\%DomainName%
V_UserValuesPath=%HKLM,"Software\matrix42\Software Depot","HomeServer"%\Values$\UserValues\%UserDomain%

[Encryption]

[Disks]
1=%Disk1%

[Options]
Installer = %InstallerName%, COPYALWAYS, Installer, "%InstallerDesc%"
Product   = %ProductName%,   COPYALWAYS, Product,   "%ProductDesc%"

[Installer]
1:..\..\..\..\User\Setup.exe,          %CommonSetupDir%, OPTIONAL USEFILENAME DIRECTORY NOSIZEWARNING SETUP, 0
1:..\..\..\..\User\SetupDeu.chm,       %CommonSetupDir%, OPTIONAL USEFILENAME DIRECTORY NOSIZEWARNING SETUP, 0
1:..\..\..\..\User\SetupEnu.chm,       %CommonSetupDir%, OPTIONAL USEFILENAME DIRECTORY NOSIZEWARNING SETUP, 0
1:%Temp%\Setup64.exe,                  %CommonSetupDir%\Setup.exe, OPTIONAL ALWAYS NOSIZEWARNING SETUP WINDOWS64,     0
1:..\..\..\..\User\Setup64.exe,        %CommonSetupDir%\Setup.exe, OPTIONAL ALWAYS NOSIZEWARNING SETUP WINDOWS64,     0
1:%SetupInfDir%\Setup.inf,                             , ALWAYS,                                             0
1:%SetupInfDir%\Setup.ico,                             , NORMAL,                                           0

[Processes]
;Proc1=ProcessName1.exe, Bitte beenden Sie "%ProductName%", KILLPROCESS ABORT

[Product]
AddMeter -1
#Set:Win64, WINDOWS64 DONTDELETE
#Set:Win32, WINDOWS32 DONTDELETE
#Set:Product, DONTDELETE
#Set:RemOldKeys,DONTDELETE
#Set:Uninstall, DELETE
#Set:NewerVersion, DONTDELETE
#Set:Win64, WINDOWS64 DELETE
#Set:Win32, WINDOWS32 DELETE
; -KillProcess "<Process>.EXE",0
; -AskKillProcesses 600, Proc1
-AddMeter -1

[Set:Win32]
Set V_MSIFileName={UnattInst}
Set V_MSIParameter=REBOOT=REALLYSUPPRESS ARPSYSTEMCOMPONENT=1 /qn /Li "%MSILogFile%"
Set V_RegWin=\WOW6432Node
Set V_Arch=x86
Set V_MSIDisplayName=
Set V_OldVersion=

[Set:Win64]
Set V_MSIFileName={UnattInst}
Set V_MSIParameter=REBOOT=REALLYSUPPRESS ARPSYSTEMCOMPONENT=1 /qn /Li "%MSILogFile%"
Set V_RegWin=
Set V_Arch=x64
Set V_MSIDisplayName=
Set V_OldVersion=

[Set:Product]
Del "%MSILogFile%"
Set V_MSIGUID = GetUninstallKeyName("%V_MSIDisplayName%", "%V_Arch%")
ReplaceEnv V_MSIGUID
; Check if a newer version already installed, Activate this Passus 
Set V_InstalledDisplayVersion = %%HKLM,"SOFTWARE%V_RegWin%\Microsoft\Windows\CurrentVersion\Uninstall\%V_MSIGUID%","DisplayVersion"%%
ReplaceEnv V_InstalledDisplayVersion
If "%V_InstalledDisplayVersion%" >= "%Version%" Then "Set:NewerVersion" EndIf
If "%V_NewerVersion%" <> "1" Then "Set:CloseApplication" EndIf

If "%V_MSIGUID%" <> "" & "%V_NewerVersion%" == "" Then "Set:RepairMSI" EndIf
If "%V_MSIGUID%" == "" & "%V_NewerVersion%" == "" Then "Set:InstallMSI" EndIf

; Delete Uninstall Link / Desktop Links / CommonPrograms Folder ("%CommonPrograms%" = "C:\ProgramData\Microsoft\Windows\Start Menu\Programs")
; Deltree "%CommonPrograms%\<FolderName>"
; Del "%CommonDesktop%\<FileName>.lnk"

[Set:CloseApplication]
; Prompt to the User if the application is running? Close the program after timeout
; AskKillProcesses 600, Proc1
; Kill Process without asking the User
; KillProcess "<Process>.EXE",0

[Set:InstallMSI]
Set ErrorLogMessage=Fehler beim Installieren von %V_MSIFileName%.
Call MsiExec /I "%Src%\%V_SourceDir%\%V_MSIFileName%" %V_MSIParameter%
If %ErrorLevel% == "3010" Then "RebootRequired" EndIf
If %ErrorLevel% <> "0" & %ErrorLevel% <> "3010" Then "Set:ErrorLogMsg" EndIf
Del "%MSILogFile%"

[Set:RepairMSI]
; Uninstall
Set ErrorLogMessage=Fehler beim Deinstallieren (Repair) von %V_MSIGUID%.
Call MsiExec /X %V_MSIGUID% REBOOT=REALLYSUPPRESS /qn /Li "%MSILogFile%"
If %ErrorLevel% == "3010" Then "RebootRequired" EndIf
If DoesRegKeyExist ("HKLM,SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\%V_MSIGUID%,UnInstallString") == "1" | DoesRegKeyExist ("HKLM,SOFTWARE\WOW6432Node\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\%V_MSIGUID%,UnInstallString") == "1" Then "Set:ErrorLogMsg" EndIf

; Install
#Set:InstallMSI

[Set:Uninstall]
-Del "%MSILogFile%"
If DoesRegKeyExist ("HKLM,SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\%V_MSIGUID%,UnInstallString") == "1" | DoesRegKeyExist ("HKLM,SOFTWARE\WOW6432Node\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\%V_MSIGUID%,UnInstallString") == "1" Then "Set:ErrorLogMsg" EndIf
If %ErrorLevel% == "3010" Then "RebootRequired" EndIf
-Call MsiExec /X %V_MSIGUID% REBOOT=REALLYSUPPRESS /qn /Li "%MSILogFile%"
Set ErrorLogMessage=Fehler beim Deinstallieren von %V_MSIGUID%.
ReplaceEnv V_MSIGUID
Set V_MSIGUID = GetUninstallKeyName("%V_MSIDisplayName%", "%V_Arch%")

[Set:RemOldKeys]
Set V_AnzahlOldVersion = Tokenize (V_OldVersion)
For Zaehler,1,%V_AnzahlOldVersion%,1,Set:CheckOldKeys

If DoesRegKeyExist ("HKLM,SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\%DeveloperName% %ProductName% %Version%,AlreadyInstalledCondition") == "1" Then "Reg:RemOldAICKeys1" EndIf

[Set:CheckOldKeys]
Set V_RemOldVersion=%%V_OldVersion%Zaehler%%%
ReplaceEnv V_RemOldVersion 

If %V_RemOldVersion% <> "" Then "Reg:RemOldKeys" EndIf
If DoesRegKeyExist ("HKLM,SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\%DeveloperName% %ProductName% %V_RemOldVersion%,AlreadyInstalledCondition") == "1" Then "Reg:RemOldAICKeys2" EndIf

[Reg:RemOldKeys]
; Remove old regkeys 
-HKLM,"SOFTWARE%V_RegWin%\Microsoft\Windows\CurrentVersion\Uninstall\Matrix42 - %DeveloperName% %ProductName% %V_RemOldVersion%"
-HKLM,"SOFTWARE%V_RegWin%\Microsoft\Windows\CurrentVersion\Uninstall\%ProductName% %V_RemOldVersion%"
-HKLM,"SOFTWARE%V_RegWin%\$Matrix42Packages$\%DeveloperName%\%ProductName%\%V_RemOldVersion%"

[Reg:RemOldAICKeys1]
-HKLM,"SOFTWARE%V_RegWin%\Microsoft\Windows\CurrentVersion\Uninstall\%DeveloperName% %ProductName% %Version%"

[Reg:RemOldAICKeys2]
-HKLM,"SOFTWARE%V_RegWin%\Microsoft\Windows\CurrentVersion\Uninstall\%DeveloperName% %ProductName% %V_RemOldVersion%"

[RebootRequired]
SetReboot 1
-SetReboot 1

[Set:NewerVersion]
If "%V_NewerVersion%" == 1 Then "Set:NewerVersionExit" EndIf
Set V_NewerVersion=1

[Set:NewerVersionExit]
#Shell:Product
Exit Software ist bereits in der Version "%V_InstalledDisplayVersion%" installiert. Installation wurde übersprungen.

[Set:ErrorLogMsg]
ErrorLogMsg %ErrorLogMessage% ErrorLevel: %ErrorLevel%
Abort %ErrorLogMessage% ErrorLevel: %ErrorLevel%
-Abort %ErrorLogMessage% ErrorLevel: %ErrorLevel%
-ErrorLogMsg %ErrorLogMessage% ErrorLevel: %ErrorLevel%

[Shell:Product]
; %Programs%\Verknüpfungsname,"%ProgramFilesDir%\Pfad\FileName.exe",,"%ProgramFilesDir%\Pfad","","%ProgramFilesDir%\Pfad\FileName.exe",0,-1,0
